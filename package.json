{
  "name": "houston-indie-30",
  "description": "Houston Indie 30 music chart platform on Cloudflare Workers and D1.",
  "private": true,
  "scripts": {
    "cf-typegen": "wrangler types",
    "check": "tsc && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "pnpm seedLocalD1 && wrangler dev",
    "predeploy": "wrangler d1 migrations apply DB --remote",
    "seedLocalD1": "wrangler d1 migrations apply DB --local"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.56.0"
  }
}
